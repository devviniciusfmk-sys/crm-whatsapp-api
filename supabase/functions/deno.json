{
  "tasks": {
    "check": "deno check agent-client/index.ts && deno test --allow-all agent-client/ _shared/",
    "evals": "deno run --allow-all --env-file=../../.env.evals agent-client/evals/run.ts",
    "deploy": "deno run --allow-all ../../scripts/subir.ts"
  },
  "fmt": {
    "lineWidth": 80,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "preserve",
    "exclude": [
      "_shared/db_types.ts"
    ]
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-unversioned-import",
        "no-import-prefix"
      ]
    }
  },
  "imports": {
    "@google/genai": "npm:@google/genai",
    "@supabase/supabase-js": "npm:@supabase/supabase-js@2.54",
    "ky": "npm:ky@^1.7",
    "@libsql/client": "npm:@libsql/client@^0.15/web",
    "mathjs": "npm:mathjs@^11.10.0",
    "mysql2": "npm:mysql2@^3.14.3/promise",
    "openai": "npm:openai@^5.12.2",
    "postgres": "npm:postgres@^3.4.7",
    "zod": "npm:zod@^4.0.9",
    "ajv": "npm:ajv@^8.17/dist/2020.js",
    "@hono/mcp": "npm:@hono/mcp",
    "@hono/hono": "jsr:@hono/hono",
    "openai/resources/chat/completions": "npm:openai@^5.12.2/resources/chat/completions",
    "@std/encoding/base64url": "jsr:@std/encoding@1.0.10/base64url",
    "@negrel/webpush": "jsr:@negrel/webpush@0.5.0",
    "dayjs": "npm:dayjs@^1.11.10",
    "dayjs/plugin/utc": "npm:dayjs@^1.11.10/plugin/utc.js"
  }
}
